---
layout: base.njk
---
<section class="s"><div class="wrap">
  <div class="eyebrow">Our work</div>
  <h1>{{ title }}</h1>
  <p class="lead">{{ lead }}</p>
  <div class="wfilter" id="wfilter" role="group" aria-label="Filter our work">
    <button class="chip on" data-k="">All</button>
    {% set groupOf = { data: 'Models and software', model: 'Models and software', simulation: 'Models and software', site: 'Models and software', game: 'Games and worlds', world: 'Games and worlds', event: 'Events', festival: 'Events', residency: 'Events', seminar: 'Events', webinars: 'Events', workshop: 'Events', talk: 'Events', school: 'Teaching', teaching: 'Teaching', publication: 'Papers and reports', report: 'Papers and reports', research: 'Papers and reports', collective: 'Partnerships', partnership: 'Partnerships' } %}
    {% for g in ['Models and software', 'Games and worlds', 'Events', 'Teaching', 'Papers and reports', 'Partnerships'] %}<button class="chip" data-k="{{ g }}">{{ g }}</button>{% endfor %}
  </div>
  <div class="cards wcards" id="wcards">
    {% for n in vault.work %}
    <a class="card wcard" data-k="{{ groupOf[n.kind] }}" href="{{ n.url | rel(page.url) }}">
      <div class="wimg">{{ n.rel | workImage | safe }}</div>
      <div class="meta"><span class="pill">{{ n.kind }}</span><span>{{ n.period }}</span></div>
      <h3>{{ n.title }}</h3><p>{{ n.summary }}</p>
      <div class="meta">{% if n.needsUrl %}<span class="pill speculative">link to add</span>{% else %}<span>{{ n.who }}</span>{% endif %}</div>
    </a>
    {% endfor %}
  </div>
  <p class="hint" style="margin-top:22px">Every entry is a Markdown note in the <code>work/</code> folder. Add one with the Work template.</p>
</div></section>
<script>
(function(){var bar=document.getElementById('wfilter');if(!bar)return;bar.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;
[].forEach.call(bar.children,function(x){x.classList.toggle('on',x===b)});var k=b.getAttribute('data-k');
[].forEach.call(document.querySelectorAll('#wcards .wcard'),function(c){c.hidden=!!k&&c.getAttribute('data-k')!==k})})})();
</script>
